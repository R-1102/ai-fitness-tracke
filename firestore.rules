rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
// Every user can only read/write their own data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && !('password' in request.resource.data);   // never store passwords

      match /sessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.correctReps is int
          && request.resource.data.wrongReps is int
          && request.resource.data.correctReps >= 0
          && request.resource.data.wrongReps >= 0
          && request.resource.data.createdAt is timestamp;
        allow update: if false;   // history is append-only
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
